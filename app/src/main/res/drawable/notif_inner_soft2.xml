<?xml version="1.0" encoding="utf-8"?>
<!-- Soft-edged inner card (16dp fade): eight white layers that add up to a ramp, tinted at runtime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:left="11dp" android:top="11dp" android:right="11dp" android:bottom="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
