<?xml version="1.0" encoding="utf-8"?>
<!-- Soft-edged inner card (28dp fade): eight white layers that add up to a ramp, tinted at runtime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="12dp" android:top="12dp" android:right="12dp" android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:left="28dp" android:top="28dp" android:right="28dp" android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#5AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
