<?xml version="1.0" encoding="utf-8"?>
<!-- Lock-screen card: the painting/sky as a frame around a dark centre that keeps the text readable. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap android:gravity="fill" android:src="@drawable/starry_frame" />
    </item>
    <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#EB0B1A3D" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#66F4C94A" />
        </shape>
    </item>
</layer-list>
